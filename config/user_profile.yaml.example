# User Profile Configuration
# Copy this file to user_profile.yaml and customize for your needs.
#
# CLI usage:
#   python3 -m src.cli --profile config/user_profile.yaml
#   python3 -m src.cli --profile config/user_profile.yaml --days 3 --output json
#
# Sample data (ingredient names in recipes must exist in your ingredients file):
#   config/recipes.example.json   — example recipes
#   config/ingredients.example.json — example ingredients (use with --ingredients)
# To try with samples:
#   python3 -m src.cli --profile config/user_profile.yaml \
#     --recipes config/recipes.example.json \
#     --ingredients config/ingredients.example.json

nutrition_goals:
  # Daily calorie target (kcal)
  daily_calories: 2400

  # Protein target (grams per day). Typical: 0.7–0.8g per lb bodyweight
  daily_protein_g: 150

  # Fat target range (grams per day). Common range: 50–100g
  daily_fat_g:
    min: 50
    max: 100

  # Carbs are derived: (calories - protein*4 - fat*9) / 4
  # using the median of the fat range

  # OPTIONAL: Hard maximum daily calories (Calorie Deficit Mode)
  # When set, plans exceeding this are rejected. Uncomment to enable:
  # max_daily_calories: 2200

  # τ: fraction of prorated weekly micronutrient RDI required (tracked nutrients only). 1.0 = strict; below relaxes the weekly floor.
  # 1.0 is the new-user default (Sprint 2 D-A); lower it here if you want looser weekly floors.
  micronutrient_weekly_min_fraction: 1.0

# Canonical schedule: one day's template, repeated for each day when you plan 2 to 7 days.
# Busyness levels (max cooking time per meal):
#   1 = snack (≤ 5 min)
#   2 = quick meal (≤ 15 min)
#   3 = weeknight meal (≤ 30 min)
#   4 = weekend / meal prep (30+ min)
# Workouts sit in the gap after meal ``after_meal_index`` (types: AM, PM, general).
schedule_days:
  - day_index: 1
    meals:
      - { index: 1, busyness_level: 4, tags: ["breakfast"], preferred_time: "07:00" }
      - { index: 2, busyness_level: 4, tags: ["lunch"], preferred_time: "12:00" }
      - { index: 3, busyness_level: 4, tags: ["dinner"], preferred_time: "18:00" }
    workouts:
      - { after_meal_index: 1, type: general }

preferences:
  liked_foods:
    - "salmon"
    - "egg"
    - "rice"
    - "potatoes"
    - "chicken"
    - "broccoli"
    - "blueberries"

  disliked_foods:
    - "brussels sprouts"
    - "liver"

  allergies:
    - "shellfish"
    - "peanuts"

demographic: "adult_male"

# Daily micronutrient goals, met as weekly totals (daily × days × τ).
# This is the new-user default for adult_male (Sprint 2 D-A): every recommended daily intake
# in data/reference/rdi_by_demographic.json except vitamin_d_iu, omega_3_g and omega_6_g, which
# the bundled starter recipes can't meet at τ = 1.0 at every new-user target. It's a starting
# point: change, remove or add any value. To track the left-out ones, add for example:
#   vitamin_d_iu: 600
#   omega_3_g: 1.6
#   omega_6_g: 17
# The default is defined once, in src/data_layer/upper_limits.py (default_micronutrient_goals).
micronutrient_goals:
  vitamin_a_ug: 900
  vitamin_c_mg: 90
  vitamin_e_mg: 15
  vitamin_k_ug: 120
  b1_thiamine_mg: 1.2
  b2_riboflavin_mg: 1.3
  b3_niacin_mg: 16
  b5_pantothenic_acid_mg: 5
  b6_pyridoxine_mg: 1.3
  b12_cobalamin_ug: 2.4
  folate_ug: 400
  calcium_mg: 1000
  copper_mg: 0.9
  iron_mg: 8
  magnesium_mg: 400
  manganese_mg: 2.3
  phosphorus_mg: 700
  potassium_mg: 3400
  selenium_ug: 55
  sodium_mg: 1500
  zinc_mg: 11
  fiber_g: 38
